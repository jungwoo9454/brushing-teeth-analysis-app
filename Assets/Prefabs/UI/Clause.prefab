  m_Script: {fileID: 11500000, guid: 5a150ecb31c570d46987e9f02adb96e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClauseView
  checkSprite: {fileID: 21300000, guid: cde6efaa9cb6a1e48b7b19822ea541e6, type: 3}
  noCheckSprite: {fileID: 21300000, guid: 5510efc924e41b84a9dcb29736461609, type: 3}
  clauses:
  - label: "<b><color=#3B7FE8>[\uD544\uC218]</color></b> \uB9CC 14\uC138 \uC774\uC0C1
      \uBC0F \uBCF4\uD638\uC790 \uB3D9\uC758"
    required: 1
    detail: "[\uB9CC 14\uC138 \uC774\uC0C1 \uBC0F \uBCF4\uD638\uC790 \uB3D9\uC758]\n\n1.
      \uBCF8 \uC571\uC758 \uACC4\uC815\uC740 \uB9CC 14\uC138 \uC774\uC0C1\uC778 \uBCF4\uD638\uC790(\uBD80\uBAA8\xB7\uC870\uBD80\uBAA8\xB7\uAD50\uC0AC
      \uB4F1)\uAC00 \uC0DD\uC131\uD558\uACE0 \uAD00\uB9AC\uD569\uB2C8\uB2E4.\n2.
      \uC544\uB3D9(\uB9CC 14\uC138 \uBBF8\uB9CC)\uC740 \uBCF4\uD638\uC790\uC758 \uC9C0\uB3C4\xB7\uAC10\uB3C5
      \uC544\uB798 \uBCF8 \uC571\uC744 \uC774\uC6A9\uD569\uB2C8\uB2E4.\n3. \uBCF4\uD638\uC790\uB294
      \uC544\uB3D9\uC758 \uBCF8 \uC571 \uC774\uC6A9\uC5D0 \uB3D9\uC758\uD558\uBA70,
      \uC774\uC6A9 \uACFC\uC815\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uC0AC\uD56D\uC744
      \uAD00\uB9AC\uD560 \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n4. \uBCF8
      \uD56D\uBAA9\uC5D0 \uB3D9\uC758\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC11C\uBE44\uC2A4
      \uAC00\uC785\uC774 \uC81C\uD55C\uB429\uB2C8\uB2E4."
  - label: "<b><color=#3B7FE8>[\uD544\uC218]</color></b> \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC57D\uAD00
      \uB3D9\uC758"
    required: 1
    detail: "[\uC11C\uBE44\uC2A4 \uC774\uC6A9\uC57D\uAD00]\n\n\uC81C1\uC870 (\uBAA9\uC801)\n\uBCF8
      \uC57D\uAD00\uC740 '\uC138\uC0B4\uBC84\uB987'(\uC774\uD558 \"\uC571\")\uC774
      \uC81C\uACF5\uD558\uB294 \uC591\uCE58 \uCF54\uCE6D \uC11C\uBE44\uC2A4\uC758
      \uC774\uC6A9 \uC870\uAC74\uACFC \uC808\uCC28\uB97C \uC815\uD569\uB2C8\uB2E4.\n\n\uC81C2\uC870
      (\uC11C\uBE44\uC2A4 \uB0B4\uC6A9)\n\uC571\uC740 \uCE74\uBA54\uB77C\uC640 \uC628\uB514\uBC14\uC774\uC2A4
      AI\uB85C \uC591\uCE58 \uB3D9\uC791\uC744 \uBD84\uC11D\uD558\uACE0, \uC62C\uBC14\uB978
      \uC591\uCE58 \uC2B5\uAD00 \uD615\uC131\uC744 \uB3D5\uB294 \uD53C\uB4DC\uBC31\xB7\uAE30\uB85D\xB7\uB9AC\uD3EC\uD2B8\uB97C
      \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\n\uC81C3\uC870 (\uC774\uC6A9\uC790\uC758
      \uC758\uBB34)\n1. \uC774\uC6A9\uC790\uB294 \uC571\uC744 \uBCF8\uB798 \uBAA9\uC801\uC5D0
      \uB9DE\uAC8C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n2. \uCE74\uBA54\uB77C\uB294 \uC591\uCE58
      \uB3D9\uC791 \uBD84\uC11D\uC5D0\uB9CC \uC0AC\uC6A9\uB418\uBA70, \uC774\uC6A9\uC790\uB294
      \uC801\uC808\uD55C \uD658\uACBD\uC5D0\uC11C \uC571\uC744 \uC0AC\uC6A9\uD560
      \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C4\uC870 (\uB370\uC774\uD130)\n1.
      \uC591\uCE58 \uAE30\uB85D \uB4F1 \uBAA8\uB4E0 \uB370\uC774\uD130\uB294 \uC774\uC6A9\uC790\uC758
      \uAE30\uAE30 \uC548\uC5D0\uB9CC \uC800\uC7A5\uB418\uBA70, \uC571\uC740 \uBCC4\uB3C4\uC758
      \uC11C\uBC84\uB85C \uB370\uC774\uD130\uB97C \uC804\uC1A1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n2.
      \uC571\uC744 \uC0AD\uC81C\uD558\uBA74 \uAE30\uAE30\uC5D0 \uC800\uC7A5\uB41C
      \uB370\uC774\uD130\uB3C4 \uD568\uAED8 \uC0AD\uC81C\uB420 \uC218 \uC788\uC73C\uB2C8
      \uC8FC\uC758\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.\n\n\uC81C5\uC870 (\uCC45\uC784\uC758
      \uD55C\uACC4)\n\uC571\uC774 \uC81C\uACF5\uD558\uB294 \uBD84\uC11D\xB7\uD53C\uB4DC\uBC31\uC740
      \uC591\uCE58 \uC2B5\uAD00 \uD615\uC131\uC744 \uB3D5\uAE30 \uC704\uD55C \uCC38\uACE0\uC6A9\uC774\uBA70,
      \uCE58\uACFC \uC9C4\uB8CC\uB098 \uC758\uD559\uC801 \uC9C4\uB2E8\uC744 \uB300\uCCB4\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC81C6\uC870 (\uC57D\uAD00\uC758 \uBCC0\uACBD)\n\uC57D\uAD00\uC740
      \uAD00\uB828 \uBC95\uB839\uC5D0 \uB530\uB77C \uBCC0\uACBD\uB420 \uC218 \uC788\uC73C\uBA70,
      \uBCC0\uACBD \uC2DC \uC571 \uB0B4 \uACF5\uC9C0\uB85C \uC548\uB0B4\uD569\uB2C8\uB2E4."
  - label: "<b><color=#3B7FE8>[\uD544\uC218]</color></b> \uAC1C\uC778\uC815\uBCF4
      \uCC98\uB9AC\uBC29\uCE68 \uB3D9\uC758"
    required: 1
    detail: "[\uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uBC29\uCE68]\n\n\uC138\uC0B4\uBC84\uB987\uC740
      \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uC18C\uC911\uD788
      \uB2E4\uB8E8\uBA70, \uB2E4\uC74C\uACFC \uAC19\uC774 \uCC98\uB9AC\uD569\uB2C8\uB2E4.\n\n1.
      \uC218\uC9D1\uD558\uB294 \uAC1C\uC778\uC815\uBCF4\n\uD604\uC7AC \uBCF8 \uC571\uC740
      \uD68C\uC6D0\uAC00\uC785\xB7\uC774\uC6A9\uC744 \uC704\uD574 \uBCC4\uB3C4\uC758
      \uAC1C\uC778\uC815\uBCF4\uB97C \uC11C\uBC84\uB85C \uC218\uC9D1\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uBCF4\uD638\uC790\xB7\uC544\uC774 \uC815\uBCF4(\uC774\uB984,
      \uD638\uCE6D, \uB098\uC774, \uC131\uBCC4), PIN, \uC591\uCE58 \uAE30\uB85D\uC740
      \uBAA8\uB450 \uC774\uC6A9\uC790\uC758 \uAE30\uAE30(\uB85C\uCEEC)\uC5D0\uB9CC
      \uC800\uC7A5\uB429\uB2C8\uB2E4.\n\n2. \uCE74\uBA54\uB77C \uC601\uC0C1\uC758
      \uCC98\uB9AC\n\uC591\uCE58 \uBD84\uC11D\uC744 \uC704\uD55C \uCE74\uBA54\uB77C
      \uC601\uC0C1\uC740 \uAE30\uAE30 \uC548\uC5D0\uC11C \uC2E4\uC2DC\uAC04\uC73C\uB85C
      \uCC98\uB9AC\uB418\uBA70, \uC800\uC7A5\uD558\uAC70\uB098 \uC678\uBD80\uB85C
      \uC804\uC1A1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n3. \uBCF4\uAD00\xB7\uD30C\uAE30\n\uBAA8\uB4E0
      \uB370\uC774\uD130\uB294 \uC774\uC6A9\uC790 \uAE30\uAE30\uC5D0 \uC800\uC7A5\uB418\uBA70,
      \uC571 \uC0AD\uC81C \uB610\uB294 \uB370\uC774\uD130 \uCD08\uAE30\uD654 \uC2DC
      \uD30C\uAE30\uB429\uB2C8\uB2E4.\n\n4. \uC81C3\uC790 \uC81C\uACF5\n\uC571\uC740
      \uC774\uC6A9\uC790\uC758 \uB370\uC774\uD130\uB97C \uC81C3\uC790\uC5D0\uAC8C
      \uC81C\uACF5\uD558\uAC70\uB098 \uC678\uBD80\uB85C \uC804\uC1A1\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\n5. \uC774\uC6A9\uC790\uC758 \uAD8C\uB9AC\n\uC774\uC6A9\uC790\uB294
      \uC5B8\uC81C\uB4E0\uC9C0 \uAE30\uAE30 \uC548\uC758 \uB370\uC774\uD130\uB97C
      \uCD08\uAE30\uD654\xB7\uC0AD\uC81C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\u203B
      \uD5A5\uD6C4 \uC11C\uBC84 \uC5F0\uB3D9 \uB4F1\uC73C\uB85C \uCC98\uB9AC \uBC29\uCE68\uC774
      \uBC14\uB014 \uACBD\uC6B0, \uC571 \uB0B4 \uACF5\uC9C0\uC640 \uC7AC\uB3D9\uC758
      \uC808\uCC28\uB85C \uC548\uB0B4\uD569\uB2C8\uB2E4."
  - label: "<b><color=#8B8F94>[\uC120\uD0DD]</color></b> \uC54C\uB9BC \uC218\uC2E0
      \uB3D9\uC758"
    required: 0
    detail: "[\uC54C\uB9BC \uC218\uC2E0 \uB3D9\uC758 (\uC120\uD0DD)]\n\n1. \uC591\uCE58
      \uC2DC\uAC04 \uC54C\uB9BC, \uC5F0\uC18D \uAE30\uB85D \uCD95\uD558 \uB4F1 \uC11C\uBE44\uC2A4
      \uC774\uC6A9\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uB294 \uC54C\uB9BC\uC744 \uAE30\uAE30\uB85C
      \uBCF4\uB0C5\uB2C8\uB2E4.\n2. \uC774 \uC54C\uB9BC\uC740 \uAE30\uAE30 \uC548\uC5D0\uC11C
      \uC0DD\uC131\uB418\uB294 \uB85C\uCEEC \uC54C\uB9BC\uC774\uBA70, \uBCC4\uB3C4\uC758
      \uAC1C\uC778\uC815\uBCF4 \uC218\uC9D1\uC744 \uC218\uBC18\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n3.
      \uC120\uD0DD \uD56D\uBAA9\uC774\uBBC0\uB85C \uB3D9\uC758\uD558\uC9C0 \uC54A\uC544\uB3C4
      \uC11C\uBE44\uC2A4\uB97C \uC815\uC0C1\uC801\uC73C\uB85C \uC774\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n4. \uC54C\uB9BC \uC218\uC2E0 \uC5EC\uBD80\uB294
      \uAE30\uAE30 \uC124\uC815 \uB610\uB294 \uC571 \uC124\uC815\uC5D0\uC11C \uC5B8\uC81C\uB4E0\uC9C0
      \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
