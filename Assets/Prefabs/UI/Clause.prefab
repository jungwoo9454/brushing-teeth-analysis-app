  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[\uB9CC 14\uC138 \uC774\uC0C1 \uBC0F \uBCF4\uD638\uC790 \uB3D9\uC758]</b>\n\n\uC138\uC0B4\uBC84\uB987\uC740
    \uC544\uC774\uC758 \uC62C\uBC14\uB978 \uC591\uCE58 \uC2B5\uAD00 \uD615\uC131\uC744
    \uB3D5\uB294 \uC11C\uBE44\uC2A4\uB85C, \uBCF4\uD638\uC790\uAC00 \uACC4\uC815\uC744
    \uB9CC\uB4E4\uACE0 \uC544\uC774\uC640 \uD568\uAED8 \uC774\uC6A9\uD558\uB294 \uAC83\uC744
    \uC804\uC81C\uB85C \uD569\uB2C8\uB2E4.\n\n1. \uBCF8 \uC571\uC758 \uACC4\uC815\uC740
    \uB9CC 14\uC138 \uC774\uC0C1\uC778 \uBCF4\uD638\uC790(\uBD80\uBAA8, \uC870\uBD80\uBAA8,
    \uAD50\uC0AC \uB4F1 \uC544\uC774\uB97C \uC2E4\uC81C\uB85C \uB3CC\uBCF4\uB294
    \uC0AC\uB78C)\uAC00 \uC0DD\uC131\uD558\uACE0 \uAD00\uB9AC\uD569\uB2C8\uB2E4.\n\n2.
    \uBCF4\uD638\uC790\uB294 \uC544\uC774\uC758 \uBC95\uC815\uB300\uB9AC\uC778\uC774\uAC70\uB098
    \uBC95\uC815\uB300\uB9AC\uC778\uC758 \uB3D9\uC758\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC73C\uB85C\uC11C,
    \uC544\uC774\uC758 \uC815\uBCF4(\uC774\uB984, \uB098\uC774, \uC131\uBCC4)\uB97C
    \uB4F1\uB85D\uD558\uACE0 \uC544\uC774\uAC00 \uC571\uC744 \uC774\uC6A9\uD558\uB294
    \uAC83\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4.\n\n3. \uB9CC 14\uC138 \uBBF8\uB9CC
    \uC544\uB3D9\uC740 \uBCF4\uD638\uC790\uC758 \uC9C0\uB3C4\uC640 \uAC10\uB3C5 \uC544\uB798
    \uC571\uC744 \uC774\uC6A9\uD558\uBA70, \uBCF4\uD638\uC790\uB294 \uC774\uC6A9
    \uC2DC\uAC04\uACFC \uC0AC\uC6A9 \uD658\uACBD(\uC695\uC2E4 \uB0B4 \uAE30\uAE30
    \uAC70\uCE58, \uBBF8\uB044\uB7EC\uC9D0, \uCE68\uC218 \uC8FC\uC758 \uB4F1)\uC744
    \uAD00\uB9AC\uD560 \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\n4. \uBCF4\uD638\uC790
    \uBAA8\uB4DC\uB294 \uBCF4\uD638\uC790\uAC00 \uC124\uC815\uD55C 4\uC790\uB9AC
    PIN\uC73C\uB85C \uBCF4\uD638\uB418\uBA70, \uBCF4\uD638\uC790\uB294 PIN\uC774
    \uC544\uC774\uB098 \uC81C3\uC790\uC5D0\uAC8C \uB178\uCD9C\uB418\uC9C0 \uC54A\uB3C4\uB85D
    \uAD00\uB9AC\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n5. \uBCF8 \uD56D\uBAA9\uC5D0
    \uB3D9\uC758\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC11C\uBE44\uC2A4 \uAC00\uC785 \uBC0F
    \uC774\uC6A9\uC774 \uC81C\uD55C\uB429\uB2C8\uB2E4."
  m_isRightToLeft: 0
