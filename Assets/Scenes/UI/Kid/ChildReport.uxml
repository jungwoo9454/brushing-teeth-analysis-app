<!-- 아이 모드 — 아동 리포트
     별점 카드 + 5구역 색상 도식(앞니 통합) + 범례 + 약한 부위 안내 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:46" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="아침 · 7:42" class="hd-sub" />
                    <ui:Label text="오늘 양치" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd">

            <!-- 종합 별점 카드 -->
            <ui:VisualElement class="card primary-soft" style="padding: 16px; align-items: center;">
                <ui:VisualElement class="stars">
                    <ui:Label text="★" class="star" />
                    <ui:Label text="★" class="star" />
                    <ui:Label text="★" class="star" />
                    <ui:Label text="★" class="star" />
                    <ui:Label text="★" class="star off" />
                </ui:VisualElement>
                <ui:Label text="세균을 많이 물리쳤어요!" class="t-h2" style="margin-top: 8px; color: var(--primary-ink);" />
                <ui:Label text="5구역 중 4개를 잘 닦았어요" class="t-body" style="color: var(--primary-ink); margin-top: 2px;" />
            </ui:VisualElement>

            <!-- 구역별 상태 (5구역: 앞니 통합) -->
            <ui:Label text="구역별 상태" class="t-cap" style="margin-bottom: 6px;" />
            <ui:VisualElement class="card" style="padding: 12px;">
                <!-- 5구역 그리드: ul · f(2행 span) · ur / ll · · lr -->
                <ui:VisualElement style="width: 260px; height: 160px; align-self: center;">
                    <ui:VisualElement style="flex-direction: row; height: 50%;">
                        <ui:VisualElement class="zone good" style="flex-grow: 1; margin-right: 6px;">
                            <ui:VisualElement class="zone-dot" />
                            <ui:Label text="위 왼쪽" />
                        </ui:VisualElement>
                        <ui:VisualElement class="zone good" style="width: 75px; height: 154px; margin-right: 6px; position: absolute; left: 95px; top: 0;">
                            <ui:VisualElement class="zone-dot" />
                            <ui:Label text="앞니" />
                        </ui:VisualElement>
                        <ui:VisualElement class="zone mid" style="flex-grow: 1; margin-left: 82px;">
                            <ui:VisualElement class="zone-dot" />
                            <ui:Label text="위 오른쪽" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; height: 50%; margin-top: 4px;">
                        <ui:VisualElement class="zone good" style="flex-grow: 1; margin-right: 6px;">
                            <ui:VisualElement class="zone-dot" />
                            <ui:Label text="아래 왼쪽" />
                        </ui:VisualElement>
                        <ui:VisualElement class="zone bad" style="flex-grow: 1; margin-left: 82px;">
                            <ui:VisualElement class="zone-dot" />
                            <ui:Label text="아래 오른쪽" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 범례 -->
            <ui:VisualElement class="row" style="justify-content: center;">
                <ui:VisualElement class="row" style="margin-right: 14px;">
                    <ui:VisualElement style="width: 10px; height: 10px; border-radius: 999px; background-color: var(--zone-good-stroke); margin-right: 6px;" />
                    <ui:Label text="잘 닦음" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-right: 14px;">
                    <ui:VisualElement style="width: 10px; height: 10px; border-radius: 999px; background-color: var(--zone-mid-stroke); margin-right: 6px;" />
                    <ui:Label text="부족" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 10px; height: 10px; border-radius: 999px; background-color: var(--zone-bad-stroke); margin-right: 6px;" />
                    <ui:Label text="미흡" class="t-cap" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 약한 부위 카드 -->
            <ui:VisualElement class="card warn">
                <ui:VisualElement class="row" style="align-items: flex-start;">
                    <ui:VisualElement style="width: 32px; height: 32px; border-radius: 10px; background-color: var(--warning); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="⚠" style="color: white;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grow">
                        <ui:Label text="아래 오른쪽 어금니" class="t-h3" />
                        <ui:Label text="저녁에 더 신경 써서 닦아 봐요!" class="t-body" style="margin-top: 2px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- 탭바 -->
        <ui:VisualElement class="tb">
            <ui:VisualElement class="tb-item" name="tab-home">
                <ui:Label text="🏠" style="font-size: 22px;" />
                <ui:Label text="홈" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item on">
                <ui:Label text="📊" style="font-size: 22px;" />
                <ui:Label text="리포트" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-reward">
                <ui:Label text="🏆" style="font-size: 22px;" />
                <ui:Label text="버디" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-parent">
                <ui:Label text="👤" style="font-size: 22px;" />
                <ui:Label text="보호자" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
