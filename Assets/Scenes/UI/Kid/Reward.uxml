<!-- 아이 모드 — 보상(버디) 화면
     캐릭터 카드 + 진화 5단계 트랙 + HP 바 + 스티커북/레벨 진입 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:46" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="나의 양치 친구" class="hd-sub" />
                    <ui:Label text="버디" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hd-right" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon">
                    <ui:Label text="⋯" style="font-size: 18px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd">

            <!-- 캐릭터 카드 -->
            <ui:VisualElement class="card primary-soft" style="padding: 16px;">
                <ui:VisualElement style="position: absolute; top: 12px; right: 14px;">
                    <ui:Label text="Lv 3 · 꼬마" class="chip" style="background-color: #FFFFFF; color: var(--primary-ink);" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: center;">
                    <ui:VisualElement style="width: 140px; height: 140px; background-color: var(--accent-soft); border-radius: 999px; align-items: center; justify-content: center;">
                        <ui:Label text="🐻" style="font-size: 90px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="bubble" style="margin-top: 8px;">
                    <ui:Label text="오늘도 잘 닦아줘서 고마워!" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 진화 단계 -->
            <ui:VisualElement class="card" style="padding: 12px;">
                <ui:VisualElement class="row between" style="margin-bottom: 10px;">
                    <ui:Label text="진화 단계" class="t-h3" />
                    <ui:Label text="3 / 5" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="justify-content: space-between;">
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 42px; height: 42px; border-radius: 999px; background-color: var(--primary-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🥚" style="font-size: 22px;" />
                        </ui:VisualElement>
                        <ui:Label text="알" class="t-cap" style="font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 42px; height: 42px; border-radius: 999px; background-color: var(--primary-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🐣" style="font-size: 22px;" />
                        </ui:VisualElement>
                        <ui:Label text="새끼" class="t-cap" style="font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 42px; height: 42px; border-radius: 999px; background-color: var(--primary); border-width: 2px; border-color: var(--primary); align-items: center; justify-content: center;">
                            <ui:Label text="🐻" style="font-size: 22px;" />
                        </ui:VisualElement>
                        <ui:Label text="꼬마" class="t-cap" style="font-size: 10px; color: var(--primary);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 42px; height: 42px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center;">
                            <ui:Label text="?" class="t-mute" />
                        </ui:VisualElement>
                        <ui:Label text="청년" class="t-cap" style="font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:VisualElement style="width: 42px; height: 42px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center;">
                            <ui:Label text="?" class="t-mute" />
                        </ui:VisualElement>
                        <ui:Label text="어른" class="t-cap" style="font-size: 10px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- HP 카드 -->
            <ui:VisualElement class="card" style="padding: 12px;">
                <ui:VisualElement class="row between">
                    <ui:VisualElement class="row">
                        <ui:Label text="HP" class="chip good" style="margin-right: 6px;" />
                        <ui:Label text="82 / 100" class="t-h3 t-num" />
                    </ui:VisualElement>
                    <ui:Label text="양치하면 회복" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="progress good" style="margin-top: 8px;">
                    <ui:VisualElement class="progress-fill" style="width: 82%;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 보상 진입 카드 2개 -->
            <ui:VisualElement class="row" style="flex-direction: row;">
                <ui:VisualElement class="card accent grow" style="padding: 12px; margin-right: 5px;" name="card-sticker">
                    <ui:VisualElement class="row between">
                        <ui:VisualElement>
                            <ui:Label text="스티커북" class="t-cap" style="color: var(--accent-ink);" />
                            <ui:VisualElement class="row" style="margin-top: 4px;">
                                <ui:Label text="14" class="t-h2 t-num" style="color: var(--accent-ink);" />
                                <ui:Label text="/30" class="t-cap" style="color: var(--accent-ink); margin-left: 2px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="›" style="font-size: 16px; color: var(--accent-ink);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card grow" style="padding: 12px; margin-left: 5px;" name="card-level">
                    <ui:VisualElement class="row between">
                        <ui:VisualElement>
                            <ui:Label text="레벨" class="t-cap" />
                            <ui:Label text="Lv 4" class="t-h2 t-num" style="margin-top: 4px;" />
                        </ui:VisualElement>
                        <ui:Label text="›" style="font-size: 16px; color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

        <ui:VisualElement class="tb">
            <ui:VisualElement class="tb-item" name="tab-home">
                <ui:Label text="🏠" style="font-size: 22px;" />
                <ui:Label text="홈" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-report">
                <ui:Label text="📊" style="font-size: 22px;" />
                <ui:Label text="리포트" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item on">
                <ui:Label text="🏆" style="font-size: 22px;" />
                <ui:Label text="버디" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-parent">
                <ui:Label text="👤" style="font-size: 22px;" />
                <ui:Label text="보호자" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
