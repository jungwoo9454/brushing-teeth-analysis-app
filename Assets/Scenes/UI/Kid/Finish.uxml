<!-- 아이 모드 — 양치 완료 화면
     큰 캐릭터(축하 무드) + ★ 별점 + 긍정 피드백 + 보상 칩 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:46" />
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="align-items: center; padding: 16px 18px 24px 18px;">

            <ui:Label text="양치 완료 · 2분 04초" class="t-cap" />
            <ui:Label text="잘했어, 하준!" class="t-display" style="font-size: 30px; margin-top: 8px;" />

            <!-- 캐릭터 (큰 축하 모션) -->
            <ui:VisualElement style="width: 170px; height: 170px; background-color: var(--accent-soft); border-radius: 999px; align-items: center; justify-content: center; margin-top: 4px;">
                <ui:Label text="🎉" style="font-size: 100px;" />
            </ui:VisualElement>

            <!-- 별점 -->
            <ui:VisualElement class="stars" style="margin-top: 16px;">
                <ui:Label text="★" class="star" style="font-size: 36px;" />
                <ui:Label text="★" class="star" style="font-size: 36px;" />
                <ui:Label text="★" class="star" style="font-size: 36px;" />
                <ui:Label text="★" class="star" style="font-size: 36px;" />
                <ui:Label text="★" class="star off" style="font-size: 36px;" />
            </ui:VisualElement>

            <!-- 긍정 피드백 카드 -->
            <ui:VisualElement class="card accent" style="margin-top: 16px; width: 100%;">
                <ui:Label text="세균을 많이 물리쳤어요! 🦠" class="t-h3" style="color: var(--accent-ink);" />
                <ui:Label text="5구역을 모두 잘 닦았어요" class="t-body" style="color: var(--accent-ink); margin-top: 2px;" />
            </ui:VisualElement>

            <!-- 보상 칩들 -->
            <ui:VisualElement class="row" style="margin-top: 16px; flex-wrap: wrap; justify-content: center;">
                <ui:Label text="★ +1 스티커" class="chip accent" style="margin-right: 6px;" />
                <ui:Label text="+20 XP" class="chip primary" style="margin-right: 6px;" />
                <ui:Label text="🔥 13일" class="chip good" />
            </ui:VisualElement>

            <ui:VisualElement class="grow" />

            <!-- 액션 버튼 -->
            <ui:VisualElement style="width: 100%;">
                <ui:Button text="리포트 보기" class="btn primary block lg" name="btn-report" />
                <ui:Button text="홈으로" class="btn ghost block" name="btn-home" style="margin-top: 8px;" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
