/* 세살버릇 — 공통 컴포넌트 스타일
 * 디자인 토큰(tokens.uss)을 참조해 컴포넌트 클래스를 정의한다.
 * 모든 화면 루트는 .scr 클래스를 가지며, 그 안에서 컴포넌트를 조합한다.
 */

/* ───── 화면 루트 ───── */
.scr {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--ink);
    -unity-font-definition: resource("Font/Pretendard-Regular SDF");
    flex-direction: column;
}

/* ───── 상태바 (모바일 상단 시계/배터리 영역) ───── */
.sb {
    height: 44px;
    padding: 14px 22px 0 22px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
}

/* ───── 헤더 ───── */
.hd {
    padding: 4px 20px 8px 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hd-left,
.hd-right {
    flex-direction: row;
    align-items: center;
}

.hd-left {
    -unity-text-align: middle-left;
}

.hd-right > * {
    margin-left: 8px;
}

.hd-title-block {
    margin-left: 10px;
    flex-direction: column;
}

.hd-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: -0.3px;
}

.hd-sub {
    font-size: 11px;
    color: var(--ink-3);
    margin-bottom: 1px;
}

.hd-icon {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background-color: var(--bg-elev);
    border-width: 1px;
    border-color: var(--line);
    align-items: center;
    justify-content: center;
}

/* ───── 바디 ───── */
.bd {
    flex-grow: 1;
    padding: 4px 18px 8px 18px;
    flex-direction: column;
}

.bd > * {
    margin-bottom: 12px;
}

/* ───── 탭바 ───── */
.tb {
    height: 78px;
    border-top-width: 1px;
    border-top-color: var(--line);
    background-color: var(--bg);
    flex-direction: row;
    padding: 8px 4px 18px 4px;
}

.tb-item {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    font-size: 10px;
    padding-top: 4px;
}

.tb-item.on {
    color: var(--primary);
    -unity-font-style: bold;
}

.tb-item Label {
    color: inherit;
    -unity-font-style: inherit;
}

/* ───── 카드 ───── */
.card {
    background-color: var(--bg-elev);
    border-radius: 14px;
    padding: 14px;
    border-width: 1px;
    border-color: var(--line);
}

.card.flat {
    border-width: 0;
}

.card.primary {
    background-color: var(--primary);
    color: var(--ink-on);
    border-color: rgba(0,0,0,0);
}

.card.primary-soft {
    background-color: var(--primary-soft);
    color: var(--primary-ink);
    border-color: rgba(0,0,0,0);
}

.card.accent {
    background-color: var(--accent-soft);
    color: var(--accent-ink);
    border-color: rgba(0,0,0,0);
}

.card.warn {
    background-color: var(--warning-soft);
    color: var(--ink);
    border-color: rgba(0,0,0,0);
}

.card.good {
    background-color: var(--success-soft);
    color: var(--ink);
    border-color: rgba(0,0,0,0);
}

.card.dashed {
    background-color: rgba(0,0,0,0);
    border-color: var(--line-strong);
    border-width: 2px;
}

/* ───── 버튼 ───── */
.btn {
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 14px;
    padding: 14px 18px;
    border-width: 0;
    background-color: var(--bg-elev);
    color: var(--ink);
    align-items: center;
    justify-content: center;
}

.btn.primary {
    background-color: var(--primary);
    color: #FFFFFF;
}

.btn.primary:active {
    background-color: var(--primary-press);
}

.btn.ghost {
    background-color: rgba(0,0,0,0);
    color: var(--ink-2);
}

.btn.block {
    width: 100%;
}

.btn.lg {
    padding: 16px 20px;
    font-size: 16px;
    border-radius: 16px;
}

/* ───── 칩 (작은 라벨) ───── */
.chip {
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background-color: var(--bg-soft);
    color: var(--ink-2);
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: var(--line);
    -unity-text-align: middle-center;
}

.chip.primary {
    background-color: var(--primary-soft);
    color: var(--primary-ink);
    border-color: rgba(0,0,0,0);
}

.chip.accent {
    background-color: var(--accent-soft);
    color: var(--accent-ink);
    border-color: rgba(0,0,0,0);
}

.chip.good {
    background-color: var(--success-soft);
    color: var(--success);
    border-color: rgba(0,0,0,0);
}

.chip.warn {
    background-color: var(--warning-soft);
    color: var(--warning);
    border-color: rgba(0,0,0,0);
}

.chip.ink {
    background-color: var(--ink);
    color: var(--bg);
    border-color: rgba(0,0,0,0);
}

/* ───── 진행률 바 ───── */
.progress {
    height: 8px;
    background-color: var(--bg-soft);
    border-radius: 999px;
    overflow: hidden;
}

.progress .progress-fill {
    height: 100%;
    background-color: var(--primary);
    border-radius: 999px;
}

.progress.accent .progress-fill { background-color: var(--accent); }
.progress.warn .progress-fill { background-color: var(--warning); }
.progress.good .progress-fill { background-color: var(--success); }

.progress.lg { height: 10px; }
.progress.thin { height: 6px; }

/* ───── 타이포 헬퍼 ───── */
.t-display {
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: -0.8px;
}

.t-h1 {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.4px;
}

.t-h2 {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: -0.3px;
}

.t-h3 {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: -0.2px;
}

.t-body {
    font-size: 13px;
    color: var(--ink-2);
}

.t-cap {
    font-size: 11px;
    color: var(--ink-3);
}

.t-mute {
    color: var(--ink-3);
}

.t-num {
    /* Pretendard에 tabular-nums 옵션이 없으면 등폭 모노로 대체 가능. 기본 폰트 사용 */
}

/* ───── 별점 ───── */
.stars {
    flex-direction: row;
}

.star {
    font-size: 28px;
    color: var(--accent);
    margin-right: 4px;
}

.star.off {
    color: var(--bg-soft);
}

/* ───── 치아 구역 타일 ───── */
.zone {
    background-color: var(--bg-soft);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-2);
    padding: 6px;
}

.zone-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--ink-3);
    margin-bottom: 2px;
}

.zone.good {
    background-color: var(--zone-good);
    border-color: var(--zone-good-stroke);
    color: var(--ink);
}

.zone.good .zone-dot { background-color: var(--zone-good-stroke); }

.zone.mid {
    background-color: var(--zone-mid);
    border-color: var(--zone-mid-stroke);
    color: var(--ink);
}

.zone.mid .zone-dot { background-color: var(--zone-mid-stroke); }

.zone.bad {
    background-color: var(--zone-bad);
    border-color: var(--zone-bad-stroke);
    color: var(--ink);
}

.zone.bad .zone-dot { background-color: var(--zone-bad-stroke); }

.zone.active {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
}

.zone.active .zone-dot { background-color: #FFFFFF; }

/* ───── 토글 (켜짐/꺼짐 스위치) ───── */
.toggle {
    width: 44px;
    height: 26px;
    background-color: var(--bg-soft);
    border-radius: 999px;
    transition: background-color 160ms;
}

.toggle .toggle-knob {
    position: absolute;
    width: 22px;
    height: 22px;
    background-color: var(--bg-elev);
    border-radius: 999px;
    top: 2px;
    left: 2px;
    transition: left 160ms ease;
}

.toggle.on { background-color: var(--primary); }
.toggle.on .toggle-knob { left: 20px; }

/* ───── 말풍선 (캐릭터 안내용) ───── */
.bubble {
    background-color: var(--bg-elev);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    padding: 10px 14px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ink);
}

/* ───── 카메라 뷰포트 (양치 중 화면용) ───── */
.cam {
    background-color: #0E1320;
    border-radius: 20px;
    overflow: hidden;
}

.cam-mouth {
    position: absolute;
    border-width: 2px;
    border-color: rgba(255,255,255,0.85);
    border-radius: 22px;
}

.cam-tracker {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--accent);
    border-width: 2px;
    border-color: #FFFFFF;
}

/* ───── 행/열 레이아웃 헬퍼 ───── */
.row {
    flex-direction: row;
    align-items: center;
}

.row.between {
    justify-content: space-between;
}

.col {
    flex-direction: column;
}

.grow {
    flex-grow: 1;
}

/* ───── 스티커 (보상 화면) ───── */
.sticker {
    border-radius: 14px;
    background-color: var(--bg-soft);
    border-width: 1px;
    border-color: var(--line-strong);
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    font-size: 11px;
}

.sticker.got {
    background-color: var(--accent-soft);
    border-color: rgba(0,0,0,0);
    color: var(--accent-ink);
    font-size: 24px;
}

/* ───── 키패드 버튼 (PIN 화면) ───── */
.keypad-btn {
    padding: 14px 0;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: var(--bg-elev);
    color: var(--ink);
    border-radius: 14px;
    border-width: 0;
    -unity-text-align: middle-center;
}

.keypad-btn.del {
    background-color: rgba(0,0,0,0);
}

/* ───── PIN 입력 박스 ───── */
.pin-cell {
    width: 44px;
    height: 52px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--line-strong);
    background-color: var(--bg-elev);
    align-items: center;
    justify-content: center;
}

.pin-cell-dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background-color: var(--primary);
}
