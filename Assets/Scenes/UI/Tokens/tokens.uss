/* 세살버릇 — 디자인 토큰
 * 무드: Soft Editorial. 따뜻한 크림(라이트) / 깊은 네이비(다크). 프라이머리 파랑.
 * 사용법: 루트에 .theme-light 또는 .theme-dark 클래스를 붙여 테마 전환.
 */

/* ───── 라이트 테마 (기본) ───── */
.theme-light {
    /* Surface */
    --bg: #F5F2EC;
    --bg-elev: #FFFFFF;
    --bg-soft: #ECE7DA;
    --bg-deep: #E5DFCC;

    /* Ink */
    --ink: #14181D;
    --ink-2: #4A5159;
    --ink-3: #8B8F94;
    --ink-on: #FFFFFF;
    --line: rgba(20, 24, 29, 0.08);
    --line-strong: rgba(20, 24, 29, 0.14);

    /* Brand */
    --primary: #3B7FE8;
    --primary-press: #2D6BCB;
    --primary-soft: #DCE9FE;
    --primary-ink: #163A78;

    /* Accent (별·보상) */
    --accent: #F5C94B;
    --accent-press: #E5B72E;
    --accent-soft: #FFF1C2;
    --accent-ink: #6B4D00;

    /* Semantic */
    --success: #4BA081;
    --success-soft: #D4EBDD;
    --warning: #E07A5F;
    --warning-soft: #F7DDD2;
    --danger: #C84A4A;
    --danger-soft: #F4D3D3;

    /* Tooth zone */
    --zone-good: #D4EBDD;
    --zone-good-stroke: #4BA081;
    --zone-mid: #FFE9B8;
    --zone-mid-stroke: #D9A623;
    --zone-bad: #F7DDD2;
    --zone-bad-stroke: #C45A3B;
}

/* ───── 다크 테마 ───── */
.theme-dark {
    --bg: #0E1320;
    --bg-elev: #1A2031;
    --bg-soft: #232A3C;
    --bg-deep: #2C344A;

    --ink: #F2F4F7;
    --ink-2: #BAC0CB;
    --ink-3: #7B8294;
    --ink-on: #14181D;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.16);

    --primary: #6B9CF0;
    --primary-press: #84AEF5;
    --primary-soft: #1F2D4D;
    --primary-ink: #BCD2F8;

    --accent: #F5D06B;
    --accent-press: #FFDB83;
    --accent-soft: #3D331A;
    --accent-ink: #FFE9A5;

    --success: #6FBE9C;
    --success-soft: #1F3A2E;
    --warning: #E89880;
    --warning-soft: #432418;
    --danger: #E47878;
    --danger-soft: #3F1E1E;

    --zone-good: #1F3A2E;
    --zone-good-stroke: #6FBE9C;
    --zone-mid: #3D2E12;
    --zone-mid-stroke: #E1BF60;
    --zone-bad: #432418;
    --zone-bad-stroke: #E89880;
}
