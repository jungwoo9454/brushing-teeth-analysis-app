<!-- 보호자 모드 — 주간 정밀 리포트
     기간 탭 + 종합 점수 + 좌우/상하 균형도 + 보조 지표 + AI 인사이트 3개 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="5/13 — 5/19" class="hd-sub" />
                    <ui:Label text="하준 · 주간 리포트" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd">

            <!-- 기간 탭 -->
            <ui:VisualElement class="row" style="flex-direction: row;">
                <ui:Label text="주" class="chip ink" style="margin-right: 6px;" />
                <ui:Label text="월" class="chip" style="margin-right: 6px;" />
                <ui:Label text="사용자 정의" class="chip" />
            </ui:VisualElement>

            <!-- 종합 점수 -->
            <ui:VisualElement class="card">
                <ui:VisualElement class="row between">
                    <ui:VisualElement>
                        <ui:Label text="종합 점수" class="t-cap" style="-unity-font-style: bold;" />
                        <ui:Label text="78/100" class="t-display t-num" style="font-size: 38px; margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: flex-end;">
                        <ui:Label text="전주 대비" class="t-cap" />
                        <ui:Label text="▲ 6점" class="t-h1" style="color: var(--success); margin-top: 2px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="progress lg" style="margin-top: 8px;">
                    <ui:VisualElement class="progress-fill" style="width: 78%;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 좌우/상하 균형도 -->
            <ui:VisualElement class="card">
                <ui:VisualElement class="row between">
                    <ui:Label text="좌·우 / 상·하 균형도" class="t-h3" />
                    <ui:Label text="아래 부족" class="chip warn" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="flex-direction: row; margin-top: 10px;">
                    <!-- 사분면 (120x120) -->
                    <ui:VisualElement style="width: 120px; height: 120px; border-width: 2px; border-color: var(--line-strong); border-radius: 10px; margin-right: 14px;">
                        <!-- 십자선 -->
                        <ui:VisualElement style="position: absolute; top: 60px; left: 0; width: 100%; height: 1px; background-color: var(--line);" />
                        <ui:VisualElement style="position: absolute; left: 60px; top: 0; width: 1px; height: 100%; background-color: var(--line);" />
                        <!-- sweet spot (성공 영역) -->
                        <ui:VisualElement style="position: absolute; top: 42px; left: 42px; width: 36px; height: 36px; background-color: var(--success-soft); border-width: 2px; border-color: var(--success); border-radius: 6px;" />
                        <!-- 측정 도트 -->
                        <ui:VisualElement style="position: absolute; top: 55px; left: 55px; width: 14px; height: 14px; border-radius: 999px; background-color: var(--primary);" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grow">
                        <ui:VisualElement>
                            <ui:VisualElement class="row between">
                                <ui:Label text="좌 / 우" class="t-cap" />
                                <ui:Label text="52 / 48" class="t-num" style="font-size: 12px; -unity-font-style: bold;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; height: 6px; background-color: var(--bg-soft); border-radius: 999px; overflow: hidden; margin-top: 4px;">
                                <ui:VisualElement style="width: 52%; background-color: var(--primary);" />
                                <ui:VisualElement style="width: 48%; background-color: var(--accent);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="margin-top: 8px;">
                            <ui:VisualElement class="row between">
                                <ui:Label text="상 / 하" class="t-cap" />
                                <ui:Label text="56 / 44" class="t-num" style="font-size: 12px; -unity-font-style: bold;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; height: 6px; background-color: var(--bg-soft); border-radius: 999px; overflow: hidden; margin-top: 4px;">
                                <ui:VisualElement style="width: 56%; background-color: var(--primary);" />
                                <ui:VisualElement style="width: 44%; background-color: var(--warning);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 보조 지표 -->
            <ui:VisualElement class="row" style="flex-direction: row;">
                <ui:VisualElement class="card grow" style="padding: 12px; margin-right: 5px;">
                    <ui:Label text="구역 커버율" class="t-cap" style="-unity-font-style: bold;" />
                    <ui:Label text="83%" class="t-h1 t-num" style="margin-top: 4px;" />
                </ui:VisualElement>
                <ui:VisualElement class="card grow" style="padding: 12px; margin-left: 5px;">
                    <ui:Label text="총 양치 시간" class="t-cap" style="-unity-font-style: bold;" />
                    <ui:Label text="13:42" class="t-h1 t-num" style="margin-top: 4px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- AI 인사이트 -->
            <ui:Label text="AI 인사이트" class="t-cap" style="margin-top: 4px; -unity-font-style: bold; color: var(--ink);" />

            <ui:VisualElement class="card warn">
                <ui:VisualElement class="row">
                    <ui:Label text="위험" class="chip warn" style="margin-right: 6px;" />
                    <ui:Label text="아래 오른쪽 어금니 5일 연속 부족" class="t-h3" />
                </ui:VisualElement>
                <ui:Label text="충치 발생률이 높은 부위입니다. 다음 양치 시 추가 안내를 활성화하세요." class="t-body" style="margin-top: 6px;" />
            </ui:VisualElement>

            <ui:VisualElement class="card">
                <ui:VisualElement class="row">
                    <ui:Label text="패턴" class="chip" style="margin-right: 6px;" />
                    <ui:Label text="저녁 양치 시간 부족" class="t-h3" />
                </ui:VisualElement>
                <ui:Label text="7일 중 5일이 90초 미만. 권장 2분 이상." class="t-body" style="margin-top: 4px;" />
            </ui:VisualElement>

            <ui:VisualElement class="card good">
                <ui:VisualElement class="row">
                    <ui:Label text="개선" class="chip good" style="margin-right: 6px;" />
                    <ui:Label text="아침 양치 12일 연속 완료" class="t-h3" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

        <ui:VisualElement class="tb">
            <ui:VisualElement class="tb-item" name="tab-home">
                <ui:Label text="🏠" style="font-size: 22px;" />
                <ui:Label text="홈" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item on">
                <ui:Label text="📊" style="font-size: 22px;" />
                <ui:Label text="리포트" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-settings">
                <ui:Label text="⚙" style="font-size: 22px;" />
                <ui:Label text="설정" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
