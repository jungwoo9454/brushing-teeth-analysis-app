<!-- 보호자 모드 — 설정
     보호자 카드 + 아이/앱/데이터/기타 그룹 + 로그아웃 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="설정" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd">

            <!-- 보호자 카드 -->
            <ui:VisualElement class="card primary-soft">
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 44px; height: 44px; border-radius: 14px; background-color: #FFFFFF; align-items: center; justify-content: center; margin-right: 12px;">
                        <ui:Label text="김" style="-unity-font-style: bold; color: var(--primary-ink);" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grow">
                        <ui:Label text="김지영 엄마" class="t-h3" style="color: var(--primary-ink);" />
                        <ui:Label text="kim.j@example.com" class="t-cap" style="color: var(--primary-ink);" />
                    </ui:VisualElement>
                    <ui:Label text="보호자" class="chip primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 아이 그룹 -->
            <ui:Label text="아이" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--accent-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="🐻" />
                        </ui:VisualElement>
                        <ui:Label text="하준 (만 5세)" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="현재" class="t-cap" style="margin-right: 6px;" />
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--accent-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="🐱" />
                        </ui:VisualElement>
                        <ui:Label text="서아 (만 7세)" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="+" />
                        </ui:VisualElement>
                        <ui:Label text="아이 추가" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 앱 그룹 -->
            <ui:Label text="앱" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="🐾" />
                        </ui:VisualElement>
                        <ui:Label text="캐릭터 변경" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="치카" class="t-cap" style="margin-right: 6px;" />
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;" name="row-notif">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="🔔" />
                        </ui:VisualElement>
                        <ui:Label text="알림 설정" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="켜짐" class="t-cap" style="margin-right: 6px;" />
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="🔒" />
                        </ui:VisualElement>
                        <ui:Label text="PIN 변경" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 데이터 그룹 -->
            <ui:Label text="데이터" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="↗" />
                        </ui:VisualElement>
                        <ui:Label text="리포트 내보내기" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="☁" />
                        </ui:VisualElement>
                        <ui:Label text="데이터 백업" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Label text="자동" class="t-cap" style="margin-right: 6px;" />
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 기타 그룹 -->
            <ui:Label text="기타" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="?" />
                        </ui:VisualElement>
                        <ui:Label text="도움말 / 문의" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--bg-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="§" />
                        </ui:VisualElement>
                        <ui:Label text="이용약관 · 개인정보" style="font-size: 14px;" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 30px; height: 30px; border-radius: 9px; background-color: var(--warning-soft); margin-right: 12px; align-items: center; justify-content: center;">
                            <ui:Label text="↦" style="color: var(--warning);" />
                        </ui:VisualElement>
                        <ui:Label text="로그아웃" style="font-size: 14px; color: var(--warning);" />
                    </ui:VisualElement>
                    <ui:Label text="›" style="color: var(--ink-3);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="세살버릇 v1.0.0" class="t-cap" style="-unity-text-align: middle-center; margin-top: 6px;" />

        </ui:ScrollView>

        <ui:VisualElement class="tb">
            <ui:VisualElement class="tb-item" name="tab-home">
                <ui:Label text="🏠" style="font-size: 22px;" />
                <ui:Label text="홈" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-report">
                <ui:Label text="📊" style="font-size: 22px;" />
                <ui:Label text="리포트" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item on">
                <ui:Label text="⚙" style="font-size: 22px;" />
                <ui:Label text="설정" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
