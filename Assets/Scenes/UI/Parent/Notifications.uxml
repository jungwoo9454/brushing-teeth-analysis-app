<!-- 보호자 모드 — 알림 설정
     마스터 토글 + 양치/습관/보호자 전용 그룹 (충치 위험 경고는 강조 카드) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">

        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="알림 설정" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd">

            <!-- 마스터 토글 -->
            <ui:VisualElement class="card">
                <ui:VisualElement class="row between">
                    <ui:VisualElement>
                        <ui:Label text="전체 알림" class="t-h3" />
                        <ui:Label text="모든 알림을 한 번에 끌 수 있어요" class="t-body" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 양치 알림 그룹 -->
            <ui:Label text="양치 알림" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="아침 양치 알림" style="font-size: 14px;" />
                        <ui:Label text="매일 07:30" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 14px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="저녁 양치 알림" style="font-size: 14px;" />
                        <ui:Label text="매일 19:30" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 14px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="주말 알림" style="font-size: 14px;" />
                        <ui:Label text="주중과 동일" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 습관 알림 그룹 -->
            <ui:Label text="습관 알림" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="연속 양치 격려" style="font-size: 14px;" />
                        <ui:Label text="3 · 7 · 14 · 30일 도달 시" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 14px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="새 스티커 · 레벨업" style="font-size: 14px;" />
                        <ui:Label text="획득 즉시" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 보호자 전용 그룹 -->
            <ui:Label text="보호자 전용" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement>
                        <ui:Label text="주간 리포트 요약" style="font-size: 14px;" />
                        <ui:Label text="매주 일요일 21:00" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 14px;" />
                <!-- 강조: 충치 위험 경고 -->
                <ui:VisualElement class="row between" style="padding: 12px 14px; background-color: var(--warning-soft);">
                    <ui:VisualElement>
                        <ui:VisualElement class="row">
                            <ui:Label text="⚠" style="color: var(--warning); margin-right: 8px;" />
                            <ui:Label text="충치 위험 경고" style="font-size: 14px;" />
                        </ui:VisualElement>
                        <ui:Label text="구역 부족 누적 시" class="t-cap" style="margin-top: 2px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="toggle on">
                        <ui:VisualElement class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="시스템 알림 권한이 필요합니다 · Android 13+" class="t-cap" style="-unity-text-align: middle-center;" />

        </ui:ScrollView>

        <ui:VisualElement class="tb">
            <ui:VisualElement class="tb-item" name="tab-home">
                <ui:Label text="🏠" style="font-size: 22px;" />
                <ui:Label text="홈" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item" name="tab-report">
                <ui:Label text="📊" style="font-size: 22px;" />
                <ui:Label text="리포트" />
            </ui:VisualElement>
            <ui:VisualElement class="tb-item on">
                <ui:Label text="⚙" style="font-size: 22px;" />
                <ui:Label text="설정" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
