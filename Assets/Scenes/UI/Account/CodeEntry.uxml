<!-- 가족 계정 04 — 초대 코드 입력 (6자리: 3 + hyphen + 3) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="초대 코드 입력" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px; align-items: center;">
            <ui:VisualElement style="width: 56px; height: 56px; border-radius: 18px; background-color: var(--primary-soft); align-items: center; justify-content: center; margin-top: 8px;">
                <ui:Label text="✨" style="font-size: 28px;" />
            </ui:VisualElement>

            <ui:Label text="가족에 합류하기" class="t-h1" style="margin-top: 14px;" />
            <ui:Label text="보호자로부터 받은 6자리 코드를&#10;입력해 주세요" class="t-body" style="-unity-text-align: middle-center; margin-top: 6px;" />

            <!-- 6자리 코드 입력 박스 (3 + hyphen + 3) -->
            <ui:VisualElement class="row" style="margin-top: 18px;">
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--line-strong); background-color: var(--bg-elev); align-items: center; justify-content: center; margin-right: 6px;">
                    <ui:Label text="S" style="font-size: 22px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--line-strong); background-color: var(--bg-elev); align-items: center; justify-content: center; margin-right: 6px;">
                    <ui:Label text="3" style="font-size: 22px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--line-strong); background-color: var(--bg-elev); align-items: center; justify-content: center; margin-right: 6px;">
                    <ui:Label text="8" style="font-size: 22px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <!-- hyphen -->
                <ui:VisualElement style="width: 12px; height: 2px; background-color: var(--line-strong); align-self: center; margin-right: 6px;" />
                <!-- active cursor cell -->
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--primary); background-color: var(--bg-elev); align-items: center; justify-content: center; margin-right: 6px;">
                    <ui:VisualElement style="width: 2px; height: 24px; background-color: var(--primary);" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--line); background-color: var(--bg-elev); margin-right: 6px;" />
                <ui:VisualElement style="width: 38px; height: 50px; border-radius: 12px; border-width: 2px; border-color: var(--line); background-color: var(--bg-elev);" />
            </ui:VisualElement>

            <!-- 안내 카드 -->
            <ui:VisualElement class="card" style="margin-top: 18px; width: 100%;">
                <ui:VisualElement class="row">
                    <ui:Label text="🔒" style="color: var(--ink-3); margin-right: 10px;" />
                    <ui:Label text="초대 코드는 보호자 모드 → 가족 멤버 관리 → 보호자 초대에서 받을 수 있어요." class="t-body" style="font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="코드 확인" class="btn primary block lg" name="btn-verify" />
            <ui:Button text="코드가 없어요 — 새 계정 만들기" class="btn ghost block" style="font-size: 13px; margin-top: 8px;" name="btn-new" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
