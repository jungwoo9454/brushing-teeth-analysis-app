<!-- 가족 계정 02 — 프로필 관리 (보호자/아이 그룹) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="프로필 관리" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd" style="padding: 8px 22px 22px 22px;">

            <ui:VisualElement class="card primary-soft">
                <ui:VisualElement class="row">
                    <ui:Label text="✨" style="color: var(--primary-ink); margin-right: 10px;" />
                    <ui:Label text="가족 멤버를 함께 관리해요. 보호자가 여러 명이면 누구든 PIN으로 보호자 모드에 들어갈 수 있어요." class="t-body" style="color: var(--primary-ink); font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 보호자 그룹 -->
            <ui:VisualElement>
                <ui:VisualElement class="row between" style="margin-bottom: 6px;">
                    <ui:Label text="보호자 (2)" class="t-cap" style="-unity-font-style: bold; color: var(--ink);" />
                    <ui:Label text="최대 4명" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="card flat" style="padding: 0;">
                    <ui:VisualElement class="row between" style="padding: 12px 14px;">
                        <ui:VisualElement class="row">
                            <ui:VisualElement style="width: 36px; height: 36px; border-radius: 10px; background-color: #3B7FE8; align-items: center; justify-content: center; margin-right: 12px;">
                                <ui:Label text="지" style="color: white; -unity-font-style: bold;" />
                            </ui:VisualElement>
                            <ui:VisualElement>
                                <ui:Label text="김지영 엄마" class="t-h3" />
                                <ui:Label text="kim.j@example.com · 나" class="t-cap" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="관리자" class="chip primary" />
                    </ui:VisualElement>
                    <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                    <ui:VisualElement class="row between" style="padding: 12px 14px;">
                        <ui:VisualElement class="row">
                            <ui:VisualElement style="width: 36px; height: 36px; border-radius: 10px; background-color: #E07A5F; align-items: center; justify-content: center; margin-right: 12px;">
                                <ui:Label text="철" style="color: white; -unity-font-style: bold;" />
                            </ui:VisualElement>
                            <ui:VisualElement>
                                <ui:Label text="박철수 아빠" class="t-h3" />
                                <ui:Label text="park.c@example.com" class="t-cap" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="보호자" class="chip" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="+ 보호자 초대" class="btn block" style="margin-top: 8px; padding: 12px; font-size: 13px; background-color: rgba(0,0,0,0); border-width: 2px; border-color: var(--line-strong); color: var(--ink-2);" name="btn-invite-parent" />
            </ui:VisualElement>

            <!-- 아이 그룹 -->
            <ui:VisualElement>
                <ui:VisualElement class="row between" style="margin-bottom: 6px;">
                    <ui:Label text="아이 (2)" class="t-cap" style="-unity-font-style: bold; color: var(--ink);" />
                    <ui:Label text="최대 5명" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement class="card flat" style="padding: 0;">
                    <ui:VisualElement class="row between" style="padding: 12px 14px;">
                        <ui:VisualElement class="row">
                            <ui:VisualElement style="width: 36px; height: 36px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 12px;">
                                <ui:Label text="🐻" style="font-size: 22px;" />
                            </ui:VisualElement>
                            <ui:VisualElement>
                                <ui:Label text="하준" class="t-h3" />
                                <ui:Label text="만 5세 · 캐릭터: 치카" class="t-cap" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 56px;" />
                    <ui:VisualElement class="row between" style="padding: 12px 14px;">
                        <ui:VisualElement class="row">
                            <ui:VisualElement style="width: 36px; height: 36px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 12px;">
                                <ui:Label text="🐱" style="font-size: 22px;" />
                            </ui:VisualElement>
                            <ui:VisualElement>
                                <ui:Label text="서아" class="t-h3" />
                                <ui:Label text="만 7세 · 캐릭터: 버블" class="t-cap" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="›" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="+ 아이 추가" class="btn block" style="margin-top: 8px; padding: 12px; font-size: 13px; background-color: rgba(0,0,0,0); border-width: 2px; border-color: var(--line-strong); color: var(--ink-2);" name="btn-add-child" />
            </ui:VisualElement>

        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
