<!-- 가족 계정 05 — 가족 합류 확인 (코드 검증 후) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="확인" class="hd-sub" />
                    <ui:Label text="가족 합류" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd" style="padding: 8px 22px 22px 22px;">

            <ui:VisualElement class="card primary-soft" style="align-items: center;">
                <ui:Label text="코드 확인 완료" class="t-cap" style="color: var(--primary-ink); -unity-font-style: bold;" />
                <ui:Label text="이 가족에 보호자로&#10;합류할 수 있어요" class="t-h2" style="-unity-text-align: middle-center; margin-top: 4px; color: var(--primary-ink);" />
            </ui:VisualElement>

            <!-- 가족 미리보기 -->
            <ui:VisualElement class="card">
                <ui:Label text="김지영 가족" class="t-cap" style="-unity-font-style: bold; color: var(--ink);" />

                <ui:Label text="보호자 1명" class="t-cap" style="margin-top: 10px; margin-bottom: 6px;" />
                <ui:VisualElement class="row">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 6px 12px; border-radius: 999px; background-color: var(--bg-soft);">
                        <ui:VisualElement style="width: 26px; height: 26px; border-radius: 8px; background-color: #3B7FE8; align-items: center; justify-content: center; margin-right: 8px;">
                            <ui:Label text="지" style="color: white; -unity-font-style: bold; font-size: 12px;" />
                        </ui:VisualElement>
                        <ui:Label text="김지영 엄마" style="font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label text="아이 2명" class="t-cap" style="margin-top: 12px; margin-bottom: 6px;" />
                <ui:VisualElement class="row" style="flex-direction: row;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 6px 12px; border-radius: 999px; background-color: var(--bg-soft); margin-right: 8px;">
                        <ui:VisualElement style="width: 26px; height: 26px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 8px;">
                            <ui:Label text="🐻" style="font-size: 16px;" />
                        </ui:VisualElement>
                        <ui:VisualElement>
                            <ui:Label text="하준" style="font-size: 13px; -unity-font-style: bold;" />
                            <ui:Label text="만 5세" class="t-cap" style="font-size: 9px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 6px 12px; border-radius: 999px; background-color: var(--bg-soft);">
                        <ui:VisualElement style="width: 26px; height: 26px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 8px;">
                            <ui:Label text="🐱" style="font-size: 16px;" />
                        </ui:VisualElement>
                        <ui:VisualElement>
                            <ui:Label text="서아" style="font-size: 13px; -unity-font-style: bold;" />
                            <ui:Label text="만 7세" class="t-cap" style="font-size: 9px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 권한 안내 -->
            <ui:VisualElement class="card">
                <ui:Label text="보호자로 받는 권한" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 8px;" />
                <ui:VisualElement class="row" style="margin-bottom: 6px;">
                    <ui:VisualElement style="width: 16px; height: 16px; border-radius: 999px; background-color: var(--success); align-items: center; justify-content: center; margin-right: 8px;">
                        <ui:Label text="✓" style="color: white; font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:Label text="하준 · 서아의 양치 데이터 확인" style="font-size: 12px; color: var(--ink-2);" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-bottom: 6px;">
                    <ui:VisualElement style="width: 16px; height: 16px; border-radius: 999px; background-color: var(--success); align-items: center; justify-content: center; margin-right: 8px;">
                        <ui:Label text="✓" style="color: white; font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:Label text="주간 정밀 리포트 · AI 인사이트 열람" style="font-size: 12px; color: var(--ink-2);" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-bottom: 6px;">
                    <ui:VisualElement style="width: 16px; height: 16px; border-radius: 999px; background-color: var(--success); align-items: center; justify-content: center; margin-right: 8px;">
                        <ui:Label text="✓" style="color: white; font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:Label text="같은 4자리 PIN으로 보호자 모드 진입" style="font-size: 12px; color: var(--ink-2);" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 16px; height: 16px; border-radius: 999px; background-color: var(--success); align-items: center; justify-content: center; margin-right: 8px;">
                        <ui:Label text="✓" style="color: white; font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:Label text="알림 설정 · 캐릭터 관리" style="font-size: 12px; color: var(--ink-2);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Label text="합류 시 이 가족의 데이터에 접근하게 됩니다." class="t-cap" style="-unity-text-align: middle-center;" />
            <ui:Button text="가족에 합류하기" class="btn primary block lg" name="btn-join" />
            <ui:Button text="취소" class="btn ghost block" style="font-size: 13px; margin-top: 8px;" name="btn-cancel" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
