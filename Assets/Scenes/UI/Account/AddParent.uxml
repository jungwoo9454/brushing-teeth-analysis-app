<!-- 가족 계정 03 — 보호자 초대 (코드 발급) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="보호자 초대" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="함께 사용할 보호자를&#10;초대해 보세요" class="t-h1" style="margin-top: 4px;" />
            <ui:Label text="가족·돌봄 선생님 누구나 보호자로 등록할 수 있어요. 한 가족 = 한 PIN을 공유합니다." class="t-body" />

            <!-- 초대 코드 카드 (primary) -->
            <ui:VisualElement class="card primary" style="padding: 16px;">
                <ui:Label text="가족 초대 코드" class="t-cap" style="color: rgba(255,255,255,0.7); -unity-font-style: bold;" />
                <ui:Label text="S38-4K2" class="t-display t-num" style="font-size: 30px; margin-top: 6px; color: white; letter-spacing: 4px;" />
                <ui:VisualElement class="row between" style="margin-top: 10px;">
                    <ui:Label text="24시간 동안 유효" style="color: rgba(255,255,255,0.7); font-size: 11px;" />
                    <ui:Button text="코드 복사" class="btn" style="padding: 6px 14px; font-size: 12px; background-color: white; color: var(--ink);" name="btn-copy" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 3단계 안내 -->
            <ui:VisualElement class="card">
                <ui:VisualElement class="row" style="margin-bottom: 8px;">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="1" style="font-size: 11px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:Label text="받은 사람이 세살버릇 앱 설치" class="t-body" style="font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-bottom: 8px;">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="2" style="font-size: 11px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:Label text="초대 코드 입력 → 보호자로 자동 연결" class="t-body" style="font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="3" style="font-size: 11px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:Label text="같은 PIN으로 보호자 모드 진입 가능" class="t-body" style="font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="이미 코드를 받았어요 →" class="btn ghost block" style="font-size: 13px;" name="btn-have-code" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
