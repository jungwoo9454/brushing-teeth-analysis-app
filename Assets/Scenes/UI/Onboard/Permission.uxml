<!-- 온보딩 08 — 카메라 권한 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="7 / 7" class="hd-sub" />
                    <ui:Label text="카메라 권한" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="카메라로 양치 자세를&#10;실시간 분석해요" class="t-h1" style="margin-top: 4px;" />

            <!-- 카메라 미리보기 -->
            <ui:VisualElement class="cam" style="height: 200px; margin-top: 4px;">
                <ui:VisualElement class="cam-mouth" style="top: 34%; left: 20%; right: 20%; bottom: 24%;" />
                <ui:VisualElement style="position: absolute; top: 12px; left: 12px; flex-direction: row; background-color: rgba(0,0,0,0.45); padding: 4px 10px; border-radius: 999px;">
                    <ui:Label text="●" style="color: #FF5C5C; font-size: 8px; margin-right: 4px; -unity-text-align: middle-left;" />
                    <ui:Label text="카메라 미리보기" style="color: white; font-size: 11px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="position: absolute; bottom: 12px; left: 12px; right: 12px; align-items: center;">
                    <ui:Label text="MediaPipe · YOLOv8" class="t-cap" style="background-color: rgba(255,255,255,0.94); padding: 6px 12px; border-radius: 10px; -unity-font-style: bold; color: var(--ink-2);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="card">
                <ui:VisualElement class="row" style="margin-bottom: 8px;">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="1" style="color: white; -unity-font-style: bold; font-size: 11px;" />
                    </ui:VisualElement>
                    <ui:Label text="입과 칫솔 위치를 자동 인식" style="font-size: 13px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="margin-bottom: 8px;">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="2" style="color: white; -unity-font-style: bold; font-size: 11px;" />
                    </ui:VisualElement>
                    <ui:Label text="기기에서만 처리, 외부 전송 없음" style="font-size: 13px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 22px; height: 22px; border-radius: 999px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                        <ui:Label text="3" style="color: white; -unity-font-style: bold; font-size: 11px;" />
                    </ui:VisualElement>
                    <ui:Label text="영상은 저장되지 않음" style="font-size: 13px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="카메라 허용" class="btn primary block lg" name="btn-allow" />
            <ui:Button text="나중에" class="btn ghost block" name="btn-skip" style="margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
