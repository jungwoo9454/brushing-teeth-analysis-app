<!-- 온보딩 03 — 약관 동의 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="2 / 7" class="hd-sub" />
                    <ui:Label text="약관 동의" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="서비스 이용에 동의해 주세요" class="t-h2" style="margin-top: 4px;" />

            <!-- 전체 동의 (강조) -->
            <ui:VisualElement class="card primary-soft">
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 26px; height: 26px; border-radius: 8px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 12px;">
                        <ui:Label text="✓" style="color: white;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grow">
                        <ui:Label text="전체 동의" class="t-h3" style="color: var(--primary-ink);" />
                        <ui:Label text="선택 항목 포함 모두 동의" class="t-cap" style="color: var(--primary-ink); margin-top: 2px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 개별 항목 6개 -->
            <ui:VisualElement class="card flat" style="padding: 0;">
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                            <ui:Label text="✓" style="color: white;" />
                        </ui:VisualElement>
                        <ui:Label text="[필수] 만 14세 이상입니다" style="font-size: 13px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 46px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                            <ui:Label text="✓" style="color: white;" />
                        </ui:VisualElement>
                        <ui:Label text="[필수] 서비스 이용약관" style="font-size: 13px;" />
                    </ui:VisualElement>
                    <ui:Label text="보기 ›" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 46px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                            <ui:Label text="✓" style="color: white;" />
                        </ui:VisualElement>
                        <ui:Label text="[필수] 개인정보 처리방침" style="font-size: 13px;" />
                    </ui:VisualElement>
                    <ui:Label text="보기 ›" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 46px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                            <ui:Label text="✓" style="color: white;" />
                        </ui:VisualElement>
                        <ui:Label text="[필수] 아동 개인정보 수집·이용 동의" style="font-size: 13px;" />
                    </ui:VisualElement>
                    <ui:Label text="보기 ›" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 46px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; background-color: var(--primary); align-items: center; justify-content: center; margin-right: 10px;">
                            <ui:Label text="✓" style="color: white;" />
                        </ui:VisualElement>
                        <ui:Label text="[필수] 카메라·음성 데이터 활용" style="font-size: 13px;" />
                    </ui:VisualElement>
                    <ui:Label text="보기 ›" class="t-cap" />
                </ui:VisualElement>
                <ui:VisualElement style="height: 1px; background-color: var(--line); margin-left: 46px;" />
                <ui:VisualElement class="row between" style="padding: 12px 14px;">
                    <ui:VisualElement class="row">
                        <ui:VisualElement style="width: 22px; height: 22px; border-radius: 6px; border-width: 2px; border-color: var(--line-strong); margin-right: 10px;" />
                        <ui:Label text="[선택] 마케팅 정보 수신" style="font-size: 13px;" />
                    </ui:VisualElement>
                    <ui:Label text="보기 ›" class="t-cap" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Label text="아동 개인정보는 보호자 동의 하에 기기 내에서만 처리되며 외부로 전송되지 않습니다." class="t-cap" />
            <ui:Button text="동의하고 계속" class="btn primary block lg" name="btn-agree" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
