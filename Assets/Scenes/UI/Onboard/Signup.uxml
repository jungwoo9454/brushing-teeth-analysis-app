<!-- 온보딩 02 — 보호자 가입 (소셜 + 이메일) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="1 / 7" class="hd-sub" />
                    <ui:Label text="보호자 가입" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:VisualElement style="margin-top: 12px;">
                <ui:Label text="먼저 보호자&#10;계정을 만들어요" class="t-h1" />
                <ui:Label text="아이의 양치 데이터는 이 계정에 안전하게 저장됩니다." class="t-body" style="margin-top: 8px;" />
            </ui:VisualElement>

            <ui:VisualElement class="grow" />

            <ui:Button text="🍎  Apple로 계속하기" class="btn block lg" style="background-color: #000; color: #FFF;" />
            <ui:Button text="🔵  Google로 계속하기" class="btn block lg" style="margin-top: 10px;" />
            <ui:VisualElement class="row" style="margin: 8px 0;">
                <ui:VisualElement class="grow" style="height: 1px; background-color: var(--line);" />
                <ui:Label text="또는" class="t-cap" style="margin: 0 10px;" />
                <ui:VisualElement class="grow" style="height: 1px; background-color: var(--line);" />
            </ui:VisualElement>
            <ui:Button text="이메일로 가입" class="btn block lg" />

            <ui:Label text="가입 시 이용약관 · 개인정보 처리방침에 동의" class="t-cap" style="-unity-text-align: middle-center; margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
