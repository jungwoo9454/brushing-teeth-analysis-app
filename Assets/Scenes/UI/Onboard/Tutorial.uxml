<!-- 온보딩 09 — 튜토리얼 (3페이지 중 첫 페이지) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 14px 22px 24px 22px;">
            <ui:VisualElement class="row between">
                <ui:Label text="튜토리얼 · 1 / 3" class="t-cap" style="-unity-font-style: bold; color: var(--ink);" />
                <ui:Button text="건너뛰기" class="btn ghost" style="padding: 6px 12px; font-size: 12px;" name="btn-skip" />
            </ui:VisualElement>

            <!-- 데모 영역 (그라데이션 배경 + 카메라 점선 박스 + 캐릭터) -->
            <ui:VisualElement style="flex-grow: 1; background-color: var(--primary-soft); border-radius: 24px; align-items: center; justify-content: flex-end; padding: 32px 40px; min-height: 280px;">
                <ui:VisualElement style="position: absolute; top: 32px; left: 40px; right: 40px; height: 130px; border-width: 2px; border-color: var(--primary); border-radius: 18px; background-color: rgba(255,255,255,0.4); align-items: center; justify-content: center;">
                    <ui:Label text="카메라 앞에 서기" style="color: var(--primary-ink); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 150px; height: 150px; background-color: var(--accent-soft); border-radius: 999px; align-items: center; justify-content: center;">
                    <ui:Label text="🐻" style="font-size: 95px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement>
                <ui:Label text="① 카메라 앞에서 양치" class="t-h1" />
                <ui:Label text="AI가 칫솔이 닿는 입속 구역을 자동으로 추적해, 어디를 닦고 있는지 실시간으로 알려줘요." class="t-body" style="margin-top: 6px;" />
            </ui:VisualElement>

            <!-- 페이지 인디케이터 -->
            <ui:VisualElement class="row" style="justify-content: center;">
                <ui:VisualElement style="width: 22px; height: 6px; border-radius: 999px; background-color: var(--primary); margin-right: 6px;" />
                <ui:VisualElement style="width: 6px; height: 6px; border-radius: 999px; background-color: var(--line-strong); margin-right: 6px;" />
                <ui:VisualElement style="width: 6px; height: 6px; border-radius: 999px; background-color: var(--line-strong);" />
            </ui:VisualElement>

            <ui:Button text="다음" class="btn primary block lg" name="btn-next" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
