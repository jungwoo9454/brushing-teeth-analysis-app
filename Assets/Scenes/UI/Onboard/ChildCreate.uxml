<!-- 온보딩 06 — 아이 프로필 (이름/나이/성별/캐릭터) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="5 / 7" class="hd-sub" />
                    <ui:Label text="아이 프로필" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="아이를 알려주세요" class="t-h1" style="margin-top: 4px;" />

            <ui:VisualElement>
                <ui:Label text="이름" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
                <ui:VisualElement class="card" style="padding: 12px 14px; border-width: 2px; border-color: var(--primary);">
                    <ui:TextField value="하준" name="field-childname" style="font-size: 15px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="row" style="flex-direction: row;">
                <ui:VisualElement class="grow" style="margin-right: 5px;">
                    <ui:Label text="나이" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
                    <ui:VisualElement class="card" style="padding: 12px 14px;">
                        <ui:VisualElement class="row between">
                            <ui:Label text="만 5세" style="font-size: 15px;" />
                            <ui:Label text="›" style="color: var(--ink-3);" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="grow" style="margin-left: 5px;">
                    <ui:Label text="성별" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
                    <ui:VisualElement class="row" style="flex-direction: row;">
                        <ui:Button text="남" class="btn" style="flex-grow: 1; padding: 12px 0; margin-right: 5px; background-color: var(--ink); color: var(--bg);" />
                        <ui:Button text="여" class="btn" style="flex-grow: 1; padding: 12px 0; margin-left: 5px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement>
                <ui:Label text="캐릭터 선택" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 6px;" />
                <ui:ScrollView mode="Horizontal" style="flex-direction: row;">
                    <ui:VisualElement style="width: 70px; padding: 10px; border-radius: 16px; background-color: var(--primary-soft); border-width: 2px; border-color: var(--primary); align-items: center; margin-right: 8px;">
                        <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🐻" style="font-size: 26px;" />
                        </ui:VisualElement>
                        <ui:Label text="치카" style="font-size: 11px; -unity-font-style: bold; margin-top: 4px; color: var(--primary-ink);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 70px; padding: 10px; border-radius: 16px; background-color: var(--bg-elev); border-width: 1px; border-color: var(--line); align-items: center; margin-right: 8px;">
                        <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🐱" style="font-size: 26px;" />
                        </ui:VisualElement>
                        <ui:Label text="버블" style="font-size: 11px; -unity-font-style: bold; margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 70px; padding: 10px; border-radius: 16px; background-color: var(--bg-elev); border-width: 1px; border-color: var(--line); align-items: center; margin-right: 8px;">
                        <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🐰" style="font-size: 26px;" />
                        </ui:VisualElement>
                        <ui:Label text="뽀송" style="font-size: 11px; -unity-font-style: bold; margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 70px; padding: 10px; border-radius: 16px; background-color: var(--bg-elev); border-width: 1px; border-color: var(--line); align-items: center;">
                        <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center;">
                            <ui:Label text="🐲" style="font-size: 26px;" />
                        </ui:VisualElement>
                        <ui:Label text="용용" style="font-size: 11px; -unity-font-style: bold; margin-top: 4px;" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="다음" class="btn primary block lg" name="btn-next" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
