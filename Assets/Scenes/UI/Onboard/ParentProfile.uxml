<!-- 온보딩 04 — 보호자 정보 (호칭 + 관계) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="3 / 7" class="hd-sub" />
                    <ui:Label text="보호자 정보" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="어떻게 불러드릴까요?" class="t-h1" style="margin-top: 4px;" />

            <ui:VisualElement>
                <ui:Label text="호칭" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 8px;" />
                <ui:VisualElement class="card" style="padding: 12px 14px; border-width: 2px; border-color: var(--primary);">
                    <ui:TextField value="김지영 엄마" name="field-name" style="font-size: 15px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement>
                <ui:Label text="관계" class="t-cap" style="-unity-font-style: bold; color: var(--ink); margin-bottom: 8px;" />
                <ui:VisualElement class="row" style="flex-wrap: wrap;">
                    <ui:Label text="엄마" class="chip ink" style="height: 36px; padding: 0 14px; margin-right: 8px; margin-bottom: 8px;" />
                    <ui:Label text="아빠" class="chip" style="height: 36px; padding: 0 14px; margin-right: 8px; margin-bottom: 8px;" />
                    <ui:Label text="조부모" class="chip" style="height: 36px; padding: 0 14px; margin-right: 8px; margin-bottom: 8px;" />
                    <ui:Label text="돌봄 선생님" class="chip" style="height: 36px; padding: 0 14px; margin-right: 8px; margin-bottom: 8px;" />
                    <ui:Label text="기타" class="chip" style="height: 36px; padding: 0 14px; margin-bottom: 8px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="다음" class="btn primary block lg" name="btn-next" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
