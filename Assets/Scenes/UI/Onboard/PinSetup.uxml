<!-- 온보딩 05 — PIN 설정 (4자리 키패드) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="4 / 7" class="hd-sub" />
                    <ui:Label text="보호자 PIN 설정" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px; align-items: center;">
            <ui:VisualElement style="width: 56px; height: 56px; border-radius: 18px; background-color: var(--primary-soft); align-items: center; justify-content: center; margin-top: 8px;">
                <ui:Label text="🔒" style="font-size: 28px;" />
            </ui:VisualElement>

            <ui:Label text="PIN 4자리" class="t-h1" style="margin-top: 14px;" />
            <ui:Label text="아이가 보호자 모드에&#10;들어가지 못하게 잠가요" class="t-body" style="-unity-text-align: middle-center; margin-top: 6px;" />

            <!-- PIN 도트 -->
            <ui:VisualElement class="row" style="margin-top: 18px;">
                <ui:VisualElement class="pin-cell" style="margin-right: 12px;">
                    <ui:VisualElement class="pin-cell-dot" />
                </ui:VisualElement>
                <ui:VisualElement class="pin-cell" style="margin-right: 12px;">
                    <ui:VisualElement class="pin-cell-dot" />
                </ui:VisualElement>
                <ui:VisualElement class="pin-cell" style="margin-right: 12px;">
                    <ui:VisualElement class="pin-cell-dot" />
                </ui:VisualElement>
                <ui:VisualElement class="pin-cell" />
            </ui:VisualElement>

            <!-- 키패드 -->
            <ui:VisualElement style="margin-top: 18px; width: 100%;">
                <ui:VisualElement class="row" style="flex-direction: row; margin-bottom: 10px;">
                    <ui:Button text="1" class="keypad-btn" style="flex-grow: 1; margin-right: 5px;" />
                    <ui:Button text="2" class="keypad-btn" style="flex-grow: 1; margin: 0 5px;" />
                    <ui:Button text="3" class="keypad-btn" style="flex-grow: 1; margin-left: 5px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="flex-direction: row; margin-bottom: 10px;">
                    <ui:Button text="4" class="keypad-btn" style="flex-grow: 1; margin-right: 5px;" />
                    <ui:Button text="5" class="keypad-btn" style="flex-grow: 1; margin: 0 5px;" />
                    <ui:Button text="6" class="keypad-btn" style="flex-grow: 1; margin-left: 5px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="flex-direction: row; margin-bottom: 10px;">
                    <ui:Button text="7" class="keypad-btn" style="flex-grow: 1; margin-right: 5px;" />
                    <ui:Button text="8" class="keypad-btn" style="flex-grow: 1; margin: 0 5px;" />
                    <ui:Button text="9" class="keypad-btn" style="flex-grow: 1; margin-left: 5px;" />
                </ui:VisualElement>
                <ui:VisualElement class="row" style="flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1; margin-right: 5px;" />
                    <ui:Button text="0" class="keypad-btn" style="flex-grow: 1; margin: 0 5px;" />
                    <ui:Button text="⌫" class="keypad-btn del" style="flex-grow: 1; margin-left: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="잊으면 이메일로 재설정 가능" class="t-cap" style="margin-top: 8px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
