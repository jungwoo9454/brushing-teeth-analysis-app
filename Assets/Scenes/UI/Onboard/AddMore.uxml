<!-- 온보딩 07 — 가족 구성 (다자녀 추가 옵션) -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Tokens/tokens.uss" />
    <Style src="../Common/common.uss" />

    <ui:VisualElement class="scr theme-light" name="root">
        <ui:VisualElement class="sb">
            <ui:Label text="오전 7:42" />
        </ui:VisualElement>

        <ui:VisualElement class="hd">
            <ui:VisualElement class="hd-left" style="flex-direction: row;">
                <ui:VisualElement class="hd-icon" name="btn-back">
                    <ui:Label text="‹" style="font-size: 22px;" />
                </ui:VisualElement>
                <ui:VisualElement class="hd-title-block">
                    <ui:Label text="6 / 7" class="hd-sub" />
                    <ui:Label text="가족 구성" class="hd-title" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bd" style="padding: 8px 22px 22px 22px;">
            <ui:Label text="다른 아이도&#10;등록할까요?" class="t-h1" style="margin-top: 4px;" />
            <ui:Label text="나중에 보호자 설정에서 추가할 수도 있어요" class="t-body" />

            <ui:VisualElement class="card">
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--accent-soft); align-items: center; justify-content: center; margin-right: 12px;">
                        <ui:Label text="🐻" style="font-size: 28px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grow">
                        <ui:Label text="하준" class="t-h3" />
                        <ui:Label text="만 5세 · 남 · 치카" class="t-cap" />
                    </ui:VisualElement>
                    <ui:Label text="등록 완료" class="chip good" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="card dashed" style="padding: 14px;">
                <ui:VisualElement class="row">
                    <ui:VisualElement style="width: 44px; height: 44px; border-radius: 999px; background-color: var(--bg-soft); align-items: center; justify-content: center; margin-right: 12px;">
                        <ui:Label text="+" class="t-h1" style="color: var(--ink-3);" />
                    </ui:VisualElement>
                    <ui:VisualElement>
                        <ui:Label text="아이 추가" class="t-h3" style="color: var(--ink-3);" />
                        <ui:Label text="최대 5명까지" class="t-cap" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="grow" />
            <ui:Button text="다음 (1명 등록)" class="btn primary block lg" name="btn-next" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
