*.7z filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# 폰트 — Assets/Font/ 하위만 LFS로. OtherAssets(MediaPipe 등 서드파티) OTF는 건드리지 않는다.
Assets/Font/**/*.otf filter=lfs diff=lfs merge=lfs -text
Assets/Font/**/*.ttf filter=lfs diff=lfs merge=lfs -text

# TextMeshPro SDF 폰트 아틀라스 — 이 폴더의 .asset만 수십 MB 바이너리라 LFS로.
# (다른 Unity .asset은 YAML 텍스트라 그대로 두고 diff 가능하게 유지)
Assets/Font/TMP/*.asset filter=lfs diff=lfs merge=lfs -text

# ML ONNX 모델 (서브모듈 Assets/Model/ 외 직접 들어올 경우 대비)
*.onnx filter=lfs diff=lfs merge=lfs -text

# MediaPipe 네이티브 라이브러리 (homuler 패키지의 macOS .dylib 등)
*.dylib filter=lfs diff=lfs merge=lfs -text

# MediaPipe Tasks 모델 파일 (face_landmarker.task 등)
*.task filter=lfs diff=lfs merge=lfs -text

# 3D 캐릭터 에셋 — FBX 메시/애니메이션, 베이크 라이트맵(EXR) 등 대용량 바이너리.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
